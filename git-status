#!/usr/bin/env python3
import subprocess
import json
import os
import sys

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    scanner_path = os.path.join(plugin_dir, "git-scanner")

    try:
        res = subprocess.run([scanner_path], capture_output=True, text=True, timeout=2.5)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        data = {}

    status = data.get("status", "UNKNOWN")
    commits = data.get("today_commits", 0)
    dirty = data.get("dirty_repos_count", 0)
    total = data.get("total_repos_scanned", 0)

    if status == "OK":
        dirty_str = f" (󱇬 {dirty})" if dirty > 0 else ""
        text = f"󰊢 {commits} commit{dirty_str}"
        css = "alert" if dirty > 0 else "normal"
    else:
        text = "󰊢 Git: Bilinmiyor"
        css = "alert"

    tooltip = f"⚡ Git Radar\n• Bugün Yapılan Commit: {commits}\n• Değişiklik Olan Depolar: {dirty}\n• Taranan Depolar: {total}\n\n[Sol Tık] Git Panelini Aç"
    print(json.dumps({"text": text, "tooltip": tooltip, "class": css}))

if __name__ == "__main__":
    main()
