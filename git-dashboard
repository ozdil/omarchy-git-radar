#!/usr/bin/env python3
import json
import subprocess
import os
import sys

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    scanner_path = os.path.join(plugin_dir, "git-scanner")

    os.system("clear")
    print("\033[1;36m=================================================================\033[0m")
    print("\033[1;33m  ⚡ GIT RADAR • Yerel Depo Nabzı ve Commit Isı Haritası \033[0m")
    print("\033[1;36m=================================================================\033[0m\n")

    try:
        res = subprocess.run([scanner_path], capture_output=True, text=True, timeout=2.5)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception as e:
        data = {"status": "UNKNOWN", "error": str(e)}

    repos = data.get("repositories", [])
    commits = data.get("today_commits", 0)
    dirty = data.get("dirty_repos_count", 0)

    print(f"📊 Bugün Yapılan Toplam Commit: {commits} | Kaydedilmemiş Değişiklik: {dirty}\n")
    print(f"{'DEPO ADI':<24} {'BUGÜNKÜ COMMIT':<18} {'DURUM':<16}")
    print("-" * 60)

    for r in repos:
        name = str(r.get("name", ""))[:22]
        c = str(r.get("today_commits", 0))
        status = "⚠️ Değişiklik Var" if r.get("is_dirty") else "✓ Temiz"
        print(f"{name:<24} {c:<18} {status:<16}")

    print("\n\033[0;90mKapatmak için Enter'a basın...\033[0m")
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass

if __name__ == "__main__":
    main()
