#!/usr/bin/env bash
set -euo pipefail

# Prefer native Quickshell UI if available
if [[ "${1:-}" != "--cli" ]] && command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.git-radar toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/gitradar-engine"

if [[ ! -x "${BIN}" ]] && [[ -f "${DIR}/Cargo.toml" ]]; then
    echo "Building gitradar-engine from source..."
    (cd "${DIR}" && cargo build --release --locked && cp "target/release/gitradar-engine" "${BIN}" && chmod +x "${BIN}") || true
fi

if [[ -x "${BIN}" ]]; then
    clear
    "${BIN}"
    echo ""
    read -r -p "Press Enter to exit..." || true
else
    echo "Engine binary not found. Please run 'cargo build --release --locked' in ${DIR}"
    exit 1
fi
