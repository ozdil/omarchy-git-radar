#!/usr/bin/env bash
# ==============================================================================
# Git Radar Workspace Scanner
# Scans local git repos for status, uncommitted files, and commit heatmap
# ==============================================================================

python3 -c "
import os
import subprocess
import json
from datetime import datetime, timedelta

search_dirs = [
    os.path.expanduser('~/.gemini/antigravity/scratch'),
    os.path.expanduser('~/Projects'),
    os.path.expanduser('~/Workspace'),
    os.path.expanduser('~/.config/omarchy')
]

found_repos = []
today_str = datetime.now().strftime('%Y-%m-%d')
week_counts = [0] * 7 # Last 7 days

for base in search_dirs:
    if not os.path.exists(base):
        continue
    for root, dirs, files in os.walk(base):
        if '.git' in dirs:
            dirs.remove('.git') # don't recurse into .git
            repo_path = root
            repo_name = os.path.basename(repo_path)

            # Get current branch
            try:
                branch = subprocess.check_output(['git', '-C', repo_path, 'branch', '--show-current'], text=True, timeout=1).strip()
            except:
                branch = 'detached'

            # Check dirty status (uncommitted / modified files)
            try:
                status_out = subprocess.check_output(['git', '-C', repo_path, 'status', '--porcelain'], text=True, timeout=1).strip()
                dirty_count = len([l for l in status_out.split('\n') if l.strip()])
            except:
                dirty_count = 0

            # Check unpushed commits
            try:
                unpushed_out = subprocess.check_output(['git', '-C', repo_path, 'log', '@{u}..HEAD', '--oneline'], text=True, timeout=1).strip()
                unpushed_count = len([l for l in unpushed_out.split('\n') if l.strip()])
            except:
                unpushed_count = 0

            # Get commit stats for the last 7 days
            try:
                log_dates = subprocess.check_output(
                    ['git', '-C', repo_path, 'log', '--since=7 days ago', '--format=%cd', '--date=short'],
                    text=True, timeout=1
                ).strip().split('\n')
                for d in log_dates:
                    d = d.strip()
                    if d:
                        for day_idx in range(7):
                            target_d = (datetime.now() - timedelta(days=6 - day_idx)).strftime('%Y-%m-%d')
                            if d == target_d:
                                week_counts[day_idx] += 1
            except:
                pass

            found_repos.append({
                'name': repo_name,
                'path': repo_path,
                'branch': branch,
                'dirty_files': dirty_count,
                'unpushed_commits': unpushed_count,
                'is_clean': dirty_count == 0 and unpushed_count == 0
            })

# Sort repos: dirty/unpushed first, then by name
found_repos.sort(key=lambda r: (r['is_clean'], r['name']))

total_dirty = sum(1 for r in found_repos if r['dirty_files'] > 0)
total_unpushed = sum(1 for r in found_repos if r['unpushed_commits'] > 0)
today_commits = week_counts[-1]

# Visual Heatmap (blocks)
heatmap_chars = ['·', '░', '▒', '▓', '█']
heatmap_visual = []
for c in week_counts:
    if c == 0:
        heatmap_visual.append('·')
    elif c <= 2:
        heatmap_visual.append('░')
    elif c <= 5:
        heatmap_visual.append('▒')
    elif c <= 10:
        heatmap_visual.append('▓')
    else:
        heatmap_visual.append('█')

output = {
    'total_repos': len(found_repos),
    'dirty_repos': total_dirty,
    'unpushed_repos': total_unpushed,
    'today_commits': today_commits,
    'week_commits': sum(week_counts),
    'heatmap': week_counts,
    'heatmap_str': ''.join(heatmap_visual),
    'status': 'DIRTY' if total_dirty > 0 else 'CLEAN',
    'status_color': '#f4a261' if total_dirty > 0 else '#00cbb8',
    'repos': found_repos[:20]
}

print(json.dumps(output, indent=2))
"
