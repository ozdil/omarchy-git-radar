#!/usr/bin/env python3
import os
import subprocess
import json
import time

MAX_REPOS = 20
MAX_DEPTH = 3
SCAN_TIMEOUT = 2.5

def get_git_repos():
    home = os.path.expanduser("~")
    search_roots = [
        os.path.join(home, "Projects"),
        os.path.join(home, "src"),
        os.path.join(home, ".gemini", "antigravity", "scratch"),
        os.path.join(home, ".config", "omarchy", "plugins"),
    ]
    
    repos = []
    start_time = time.time()

    for root in search_roots:
        if not os.path.exists(root):
            continue
        for dirpath, dirnames, _ in os.walk(root):
            # Enforce hard time and count budgets
            if time.time() - start_time > SCAN_TIMEOUT or len(repos) >= MAX_REPOS:
                break
            # Skip hidden / deep folders
            depth = len(os.path.relpath(dirpath, root).split(os.sep))
            if depth > MAX_DEPTH:
                dirnames.clear()
                continue
            if ".git" in dirnames:
                repos.append(dirpath)
                dirnames.remove(".git") # Don't descend into .git
                if len(repos) >= MAX_REPOS:
                    break
    return repos

def inspect_repo(repo_path):
    try:
        # Check uncommitted changes (bounded timeout)
        res_status = subprocess.run(
            ["git", "-C", repo_path, "status", "--porcelain"],
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False
        )
        is_dirty = bool(res_status.stdout.strip())

        # Count today's commits by author
        res_log = subprocess.run(
            ["git", "-C", repo_path, "log", "--since=midnight", "--oneline"],
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False
        )
        today_commits = len(res_log.stdout.strip().splitlines()) if res_log.stdout.strip() else 0

        return {
            "name": os.path.basename(repo_path)[:30],
            "path": repo_path[:80],
            "is_dirty": is_dirty,
            "today_commits": today_commits
        }
    except Exception:
        return None

def main():
    try:
        repos = get_git_repos()
        repo_data = []
        total_commits_today = 0
        dirty_repos_count = 0

        for r in repos:
            info = inspect_repo(r)
            if info:
                repo_data.append(info)
                total_commits_today += info["today_commits"]
                if info["is_dirty"]:
                    dirty_repos_count += 1

        print(json.dumps({
            "status": "OK",
            "total_repos_scanned": len(repo_data),
            "today_commits": total_commits_today,
            "dirty_repos_count": dirty_repos_count,
            "repositories": repo_data[:15]
        }))
    except Exception as e:
        print(json.dumps({
            "status": "UNKNOWN",
            "error": str(e)[:60],
            "total_repos_scanned": 0,
            "today_commits": 0,
            "dirty_repos_count": 0,
            "repositories": []
        }))

if __name__ == "__main__":
    main()
